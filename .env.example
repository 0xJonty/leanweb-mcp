# Copy to .env and edit. With Docker Compose every LEANWEB_* value below is passed to the container.
# Empty or missing values use the defaults shown.

# ---- Docker Compose only
# Generate with: openssl rand -hex 32   (required, SearXNG will not start without it)
SEARXNG_SECRET=
# Host address/port the MCP endpoint is published on. 127.0.0.1 = this machine only.
# To use it from other machines set your LAN address, and add it to LEANWEB_ALLOWED_HOSTS below.
LEANWEB_BIND=127.0.0.1
LEANWEB_PUBLISH_PORT=8200

# ---- Server
# Bind address/port when running without Docker (inside the container these are fixed, so they stay commented).
# LEANWEB_HOST=127.0.0.1
# LEANWEB_PORT=8200
LEANWEB_PATH=/mcp
LEANWEB_LOG_LEVEL=INFO
# Host headers the server accepts (DNS-rebinding protection). "host:*" = any port. "*" disables the check.
# Exposing on a LAN? Add the address clients use, e.g. localhost:*,127.0.0.1:*,192.0.2.10:8200
LEANWEB_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,[::1]:*
# Browser Origin headers accepted (requests without Origin, e.g. from server-side clients, always pass).
LEANWEB_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*

# ---- Fetching
# 1 = allow fetching loopback/private/link-local addresses (your LAN, Docker networks). Off by default.
LEANWEB_ALLOW_PRIVATE_URLS=0
# If plain HTTP returns fewer cleaned chars than this, retry with a headless browser.
LEANWEB_MIN_CONTENT_CHARS=500
# Seconds.
LEANWEB_HTTP_TIMEOUT=20
LEANWEB_BROWSER_TIMEOUT=45
# Max simultaneous browser fetches.
LEANWEB_BROWSER_CONCURRENCY=2
# Raw HTML beyond this many chars is ignored.
LEANWEB_MAX_HTML_CHARS=8000000

# ---- Cache
# Cleaned pages are cached per URL for this long, so reading several sections fetches once.
LEANWEB_CACHE_TTL_HOURS=6
# Without Docker only (Compose uses the leanweb-cache volume at /data/cache).
# LEANWEB_CACHE_DIR=./cache

# ---- Search
# Without Docker, or to use an external SearXNG instead of the bundled one (Compose default: http://searxng:8080).
# LEANWEB_SEARXNG_URL=http://127.0.0.1:8080
LEANWEB_SEARCH_TIMEOUT=25
LEANWEB_SEARCH_DEFAULT_RESULTS=5
LEANWEB_SEARCH_MAX_RESULTS=10
LEANWEB_SNIPPET_CHARS=200

# ---- Output caps (characters; ~4 chars per token)
LEANWEB_INFO_MAX_CHARS=3000
LEANWEB_FIND_MAX_CHARS=2000
LEANWEB_SEARCH_MAX_CHARS=2500
# Hard ceiling for page_section / page_head / page_select, whatever max_chars the model asks for.
LEANWEB_READ_CEILING=16000
LEANWEB_SECTION_DEFAULT_CHARS=12000
LEANWEB_HEAD_DEFAULT_CHARS=4000
LEANWEB_SELECT_DEFAULT_CHARS=8000
